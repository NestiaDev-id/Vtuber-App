# VTuber Application Environment Variables
# Copy this file to .env and fill in your API keys

# DeepSeek API Key
# Get it from https://platform.deepseek.com
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq API Key  
# Get it from https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key
# Get it from https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# MISTRAL API Key
# Get it from https://console.mistral.ai
VITE_MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI API Key
# Get it from https://platform.openai.com
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Tauri Signing Private Key
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
APP_ASSET_SALT=

# Kyber-1024 Post-Quantum Keys (base64-encoded)
# Generate with: cargo run --bin encrypt_content -- --generate-keys
# Then convert keys/kyber_keypair.bin to base64
KYBER_PUBLIC_KEY=
KYBER_SECRET_KEY=